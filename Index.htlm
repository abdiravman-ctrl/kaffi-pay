<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>KaffiPay — Échange 1xBet ↔ Waafi · Djibouti</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg: #0d0f14;
    --surface: #141720;
    --surface2: #1a1e2a;
    --border: rgba(255,255,255,0.07);
    --gold: #f5c842;
    --gold-dim: rgba(245,200,66,0.15);
    --gold-border: rgba(245,200,66,0.3);
    --green: #2ecc71;
    --red: #e74c3c;
    --text: #e8eaf0;
    --muted: #6b7280;
    --radius: 16px;
  }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'DM Sans', sans-serif;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Ambient glow background */
  body::before {
    content: '';
    position: fixed;
    top: -200px; left: 50%;
    transform: translateX(-50%);
    width: 600px; height: 600px;
    background: radial-gradient(circle, rgba(245,200,66,0.06) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .wrapper {
    width: 100%;
    max-width: 480px;
    padding: 0 16px 60px;
    position: relative;
    z-index: 1;
  }

  /* HEADER */
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 0 24px;
  }

  .logo-wrap {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .logo-icon {
    width: 48px; height: 48px;
    border-radius: 50%;
    background: var(--gold);
    display: flex; align-items: center; justify-content: center;
    font-size: 20px;
    box-shadow: 0 0 20px rgba(245,200,66,0.35);
    flex-shrink: 0;
  }

  .logo-text {
    font-family: 'Syne', sans-serif;
    font-size: 22px;
    font-weight: 800;
    line-height: 1;
  }
  .logo-text span { color: var(--gold); }
  .logo-sub {
    font-size: 11px;
    color: var(--muted);
    margin-top: 3px;
    letter-spacing: 0.02em;
  }

  .secure-badge {
    display: flex; align-items: center; gap: 6px;
    border: 1px solid var(--gold-border);
    background: var(--gold-dim);
    padding: 6px 12px;
    border-radius: 99px;
    font-size: 12px;
    color: var(--gold);
    font-weight: 600;
  }

  /* PROMO BANNER */
  .promo-banner {
    background: var(--surface2);
    border: 1px solid var(--gold-border);
    border-radius: var(--radius);
    padding: 14px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
    animation: slideDown 0.5s ease both;
  }

  .promo-left {
    font-size: 12px;
    color: var(--muted);
    margin-bottom: 4px;
  }
  .promo-code {
    font-family: 'Syne', sans-serif;
    font-size: 22px;
    font-weight: 800;
    color: var(--gold);
    letter-spacing: 0.05em;
  }

  .copy-btn {
    background: var(--gold);
    color: #0d0f14;
    border: none;
    border-radius: 10px;
    padding: 10px 16px;
    font-family: 'DM Sans', sans-serif;
    font-weight: 700;
    font-size: 13px;
    cursor: pointer;
    display: flex; align-items: center; gap: 6px;
    transition: transform 0.15s, box-shadow 0.15s;
    white-space: nowrap;
  }
  .copy-btn:hover { transform: scale(1.04); box-shadow: 0 4px 16px rgba(245,200,66,0.4); }
  .copy-btn:active { transform: scale(0.97); }

  /* INFO CARD */
  .info-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px;
    margin-bottom: 20px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted);
    animation: slideDown 0.5s 0.1s ease both;
  }
  .info-card strong { color: var(--text); }

  /* TABS */
  .tabs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-bottom: 20px;
    animation: slideDown 0.5s 0.15s ease both;
  }

  .tab-btn {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 14px;
    font-family: 'DM Sans', sans-serif;
    font-size: 15px;
    font-weight: 600;
    color: var(--muted);
    cursor: pointer;
    display: flex; align-items: center; justify-content: center; gap: 8px;
    transition: all 0.2s;
  }
  .tab-btn.active {
    background: var(--surface2);
    border-color: var(--gold-border);
    color: var(--gold);
    box-shadow: 0 0 20px rgba(245,200,66,0.1);
  }
  .tab-btn:hover:not(.active) { border-color: rgba(255,255,255,0.15); color: var(--text); }

  /* FORM CARD */
  .form-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
    animation: slideDown 0.5s 0.2s ease both;
  }

  .form-title {
    font-family: 'Syne', sans-serif;
    font-size: 20px;
    font-weight: 800;
    display: flex; align-items: center; gap: 8px;
    margin-bottom: 4px;
  }
  .form-sub {
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 20px;
  }

  /* Payment info box */
  .pay-info-box {
    background: var(--surface2);
    border: 1px solid var(--gold-border);
    border-radius: 12px;
    padding: 14px 16px;
    margin-bottom: 20px;
  }
  .pay-info-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--gold);
    display: flex; align-items: center; gap: 6px;
    margin-bottom: 12px;
  }
  .pay-info-row {
    display: flex; align-items: center; justify-content: space-between;
    padding: 6px 0;
    font-size: 14px;
  }
  .pay-info-row + .pay-info-row { border-top: 1px solid var(--border); }
  .pay-info-key { color: var(--muted); display: flex; align-items: center; gap: 6px; }
  .pay-info-val {
    font-weight: 700;
    font-size: 20px;
    color: var(--gold);
    display: flex; align-items: center; gap: 8px;
  }
  .pay-info-val.name { font-size: 15px; color: var(--text); }

  .icon-copy {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    width: 32px; height: 32px;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    font-size: 14px;
    transition: background 0.15s;
    flex-shrink: 0;
  }
  .icon-copy:hover { background: var(--surface2); }

  /* INSTRUCTIONS (withdrawal) */
  .instructions {
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 14px 16px;
    margin-bottom: 20px;
  }
  .instr-title {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.07em;
    color: var(--gold);
    display: flex; align-items: center; gap: 6px;
    margin-bottom: 10px;
  }
  .instr-step {
    display: flex; align-items: flex-start; gap: 8px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--muted);
    margin-bottom: 6px;
  }
  .instr-step::before {
    content: '→';
    color: var(--gold);
    flex-shrink: 0;
    margin-top: 1px;
  }
  .instr-step strong { color: var(--text); }

  /* FIELD */
  .field { margin-bottom: 16px; }
  .field-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--muted);
    display: flex; align-items: center; gap: 6px;
    margin-bottom: 8px;
  }
  .field-input-wrap {
    display: flex;
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    transition: border-color 0.2s;
  }
  .field-input-wrap:focus-within { border-color: var(--gold-border); }

  .field-prefix {
    padding: 14px 14px;
    font-size: 13px;
    font-weight: 700;
    color: var(--gold);
    background: rgba(245,200,66,0.08);
    border-right: 1px solid var(--border);
    white-space: nowrap;
    display: flex; align-items: center;
  }

  input[type="text"], input[type="number"], input[type="tel"] {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: var(--text);
    font-family: 'DM Sans', sans-serif;
    font-size: 15px;
    padding: 14px 16px;
  }
  input::placeholder { color: var(--muted); }

  /* Payment method selector */
  .method-selector {
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 14px 16px;
    display: flex; align-items: center; gap: 12px;
    margin-bottom: 16px;
  }
  .method-icon {
    width: 40px; height: 40px;
    border-radius: 50%;
    background: #8B1A8B;
    display: flex; align-items: center; justify-content: center;
    font-size: 18px;
    font-weight: 800;
    color: white;
    flex-shrink: 0;
  }
  .method-name { font-weight: 600; font-size: 14px; }
  .method-desc { font-size: 12px; color: var(--muted); }

  /* SUBMIT */
  .submit-btn {
    width: 100%;
    background: var(--gold);
    color: #0d0f14;
    border: none;
    border-radius: 14px;
    padding: 16px;
    font-family: 'Syne', sans-serif;
    font-size: 16px;
    font-weight: 800;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center; gap: 8px;
    letter-spacing: 0.01em;
    transition: transform 0.15s, box-shadow 0.2s;
    margin-top: 4px;
  }
  .submit-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 28px rgba(245,200,66,0.4); }
  .submit-btn:active { transform: translateY(0); }

  /* SUPPORT */
  .support-btn {
    width: 100%;
    background: transparent;
    border: 1px solid rgba(46,204,113,0.3);
    border-radius: 14px;
    padding: 14px;
    color: var(--green);
    font-family: 'DM Sans', sans-serif;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center; gap: 8px;
    margin-top: 12px;
    transition: background 0.2s;
  }
  .support-btn:hover { background: rgba(46,204,113,0.07); }

  /* SUCCESS / ORDER TRACKING */
  .tracking-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 24px 20px;
    display: none;
    animation: slideDown 0.5s ease both;
  }

  .status-box {
    text-align: center;
    padding: 24px 0 20px;
  }
  .status-emoji { font-size: 52px; margin-bottom: 12px; display: block; animation: pulse 2s ease infinite; }
  .status-title {
    font-family: 'Syne', sans-serif;
    font-size: 22px;
    font-weight: 800;
    color: var(--gold);
    margin-bottom: 8px;
  }
  .status-desc { font-size: 13px; color: var(--muted); line-height: 1.6; max-width: 280px; margin: 0 auto; }

  .progress-bar {
    height: 4px;
    background: var(--surface2);
    border-radius: 99px;
    overflow: hidden;
    margin: 16px 0 0;
  }
  .progress-fill {
    height: 100%;
    background: var(--gold);
    border-radius: 99px;
    width: 35%;
    animation: progressAnim 2s ease-out both;
  }

  .ref-box {
    background: var(--surface2);
    border: 1px solid var(--gold-border);
    border-radius: 12px;
    padding: 14px 16px;
    display: flex; align-items: center; justify-content: space-between;
    margin: 20px 0;
  }
  .ref-label { font-size: 11px; letter-spacing: 0.08em; color: var(--muted); margin-bottom: 4px; text-transform: uppercase; }
  .ref-value {
    font-family: 'Syne', sans-serif;
    font-size: 22px;
    font-weight: 800;
    color: var(--gold);
  }

  .details-table { margin-bottom: 20px; }
  .details-title {
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--muted);
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .detail-row {
    display: flex; align-items: center; justify-content: space-between;
    padding: 10px 0;
    font-size: 14px;
    border-bottom: 1px solid var(--border);
  }
  .detail-row:last-child { border-bottom: none; }
  .detail-key { color: var(--muted); }
  .detail-val { font-weight: 600; text-align: right; }

  /* PROGRESSION */
  .progression { margin-top: 8px; }
  .prog-title {
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--muted);
    text-transform: uppercase;
    margin-bottom: 16px;
  }
  .prog-step {
    display: flex; align-items: flex-start; gap: 14px;
    margin-bottom: 20px;
    position: relative;
  }
  .prog-step:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 19px; top: 40px;
    width: 2px;
    height: calc(100% - 4px);
    background: var(--border);
  }
  .prog-icon {
    width: 40px; height: 40px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 18px;
    flex-shrink: 0;
    border: 2px solid var(--border);
    background: var(--surface2);
  }
  .prog-icon.done { background: rgba(46,204,113,0.15); border-color: var(--green); }
  .prog-icon.active { background: var(--gold-dim); border-color: var(--gold-border); animation: pulse 1.5s ease infinite; }
  .prog-name { font-weight: 600; font-size: 14px; }
  .prog-name.done { color: var(--green); }
  .prog-name.active { color: var(--gold); }
  .prog-desc { font-size: 12px; color: var(--muted); margin-top: 2px; }

  /* BACK BTN */
  .back-btn {
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 8px 14px;
    color: var(--text);
    font-family: 'DM Sans', sans-serif;
    font-size: 13px;
    cursor: pointer;
    transition: background 0.15s;
    display: flex; align-items: center; gap: 6px;
  }
  .back-btn:hover { background: var(--surface2); }

  /* TOAST */
  .toast {
    position: fixed;
    bottom: 24px; left: 50%;
    transform: translateX(-50%) translateY(80px);
    background: var(--surface2);
    border: 1px solid var(--gold-border);
    border-radius: 12px;
    padding: 12px 20px;
    font-size: 14px;
    font-weight: 600;
    color: var(--gold);
    box-shadow: 0 8px 32px rgba(0,0,0,0.5);
    transition: transform 0.3s cubic-bezier(0.34,1.56,0.64,1);
    z-index: 100;
    white-space: nowrap;
    display: flex; align-items: center; gap: 8px;
  }
  .toast.show { transform: translateX(-50%) translateY(0); }

  /* FOOTER */
  footer {
    text-align: center;
    padding: 24px 0 0;
    font-size: 12px;
    color: var(--muted);
    line-height: 1.8;
  }
  footer strong { color: var(--gold); font-family: 'Syne', sans-serif; }

  /* ANIMATIONS */
  @keyframes slideDown {
    from { opacity: 0; transform: translateY(-14px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.6; }
  }
  @keyframes progressAnim {
    from { width: 0; }
    to { width: 35%; }
  }

  /* Responsive tweaks */
  @media (max-width: 400px) {
    .logo-text { font-size: 18px; }
    .ref-value { font-size: 18px; }
  }
</style>
</head>
<body>
<div class="wrapper">

  <!-- HEADER -->
  <header>
    <div class="logo-wrap">
      <div class="logo-icon">💰</div>
      <div>
        <div class="logo-text">Kaffi<span>Pay</span></div>
        <div class="logo-sub">Échange 1xBet ↔ Waafi · Djibouti</div>
      </div>
    </div>
    <div id="secureOrBack">
      <div class="secure-badge">🔒 Sécurisé</div>
    </div>
  </header>

  <!-- PROMO BANNER -->
  <div class="promo-banner">
    <div>
      <div class="promo-left">🎁 Code promo pour réduire vos pertes :</div>
      <div class="promo-code">kaffi10</div>
    </div>
    <button class="copy-btn" onclick="copyText('kaffi10', this)">📋 Copier</button>
  </div>

  <!-- INFO CARD -->
  <div class="info-card">
    Soumettez votre ordre de <strong>dépôt ou retrait 1xBet</strong> — un agent le traite sous <strong>5 à 15 minutes</strong>.
  </div>

  <!-- TABS -->
  <div class="tabs">
    <button class="tab-btn active" id="tabDeposit" onclick="switchTab('deposit')">🏦 Dépôt 1xBet</button>
    <button class="tab-btn" id="tabWithdraw" onclick="switchTab('withdraw')">📤 Retrait 1xBet</button>
  </div>

  <!-- ===== DEPOSIT FORM ===== -->
  <div class="form-card" id="formDeposit">
    <div class="form-title">💰 Dépôt 1xBet</div>
    <div class="form-sub">Rechargez votre compte 1xBet via Waafi</div>

    <div class="pay-info-box">
      <div class="pay-info-label">📲 ENVOYEZ D'ABORD VOTRE PAIEMENT À :</div>
      <div class="pay-info-row">
        <span class="pay-info-key">📱 Numéro Waafi</span>
        <span class="pay-info-val">
          77043065
          <span class="icon-copy" onclick="copyText('77043065', this)">📋</span>
        </span>
      </div>
      <div class="pay-info-row">
        <span class="pay-info-key">👤 Nom du compte</span>
        <span class="pay-info-val name">Abdirahman Abdi</span>
      </div>
    </div>

    <div class="field">
      <div class="field-label">💵 MONTANT (MIN. 50 DJF)</div>
      <div class="field-input-wrap">
        <div class="field-prefix">DJF</div>
        <input type="number" id="d_amount" placeholder="Ex: 1000" min="50">
      </div>
    </div>

    <div class="field">
      <div class="field-label">🎯 ID COMPTE 1XBET</div>
      <div class="field-input-wrap">
        <input type="text" id="d_id" placeholder="Ex: 123456789">
      </div>
    </div>

    <div class="field">
      <div class="field-label">🏷️ HASH TRANSACTION WAAFI</div>
      <div class="field-input-wrap">
        <input type="text" id="d_hash" placeholder="Ex: TXN-WAAFI-XXXXXXXX">
      </div>
    </div>

    <div class="field">
      <div class="field-label">📞 VOTRE NUMÉRO WAAFI (OPTIONNEL)</div>
      <div class="field-input-wrap">
        <input type="tel" id="d_phone" placeholder="Ex: 77XXXXXXX">
      </div>
    </div>

    <button class="submit-btn" onclick="submitDeposit()">⚡ Soumettre l'Ordre</button>
    <button class="support-btn">💬 Support WhatsApp — Un problème ?</button>
  </div>

  <!-- ===== WITHDRAWAL FORM ===== -->
  <div class="form-card" id="formWithdraw" style="display:none;">
    <div class="form-title">📤 Retrait 1xBet</div>
    <div class="form-sub">Recevez votre argent sur Waafi</div>

    <div class="instructions">
      <div class="instr-title">📋 Instructions retrait 1xBet</div>
      <div class="instr-step">Allez sur <strong>1xBet → Retrait</strong></div>
      <div class="instr-step">Sélectionnez <strong>Espèces</strong></div>
      <div class="instr-step">Choisissez ville <strong>Djibouti</strong></div>
      <div class="instr-step">Sélectionnez rue <strong>Kaffi Activity</strong></div>
      <div class="instr-step">Entrez montant et confirmez</div>
      <div class="instr-step">Copiez le <strong>code de retrait</strong> ci-dessous</div>
    </div>

    <div class="field">
      <div class="field-label">🔑 CODE DE RETRAIT 1XBET</div>
      <div class="field-input-wrap">
        <input type="text" id="w_code" placeholder="Ex: RET-XXXXXXXX">
      </div>
    </div>

    <div class="method-selector">
      <div class="method-icon">W</div>
      <div>
        <div class="method-name">Waafi Mobile Money</div>
        <div class="method-desc">Réception instantanée</div>
      </div>
    </div>

    <div class="field">
      <div class="field-label">📞 VOTRE NUMÉRO WAAFI</div>
      <div class="field-input-wrap">
        <input type="tel" id="w_phone" placeholder="Ex: 77XXXXXXX">
      </div>
    </div>

    <div class="field">
      <div class="field-label">💵 MONTANT (MIN. 250 DJF)</div>
      <div class="field-input-wrap">
        <div class="field-prefix">DJF</div>
        <input type="number" id="w_amount" placeholder="Ex: 500" min="250">
      </div>
    </div>

    <button class="submit-btn" onclick="submitWithdraw()">⚡ Soumettre l'Ordre</button>
    <button class="support-btn">💬 Support WhatsApp — Un problème ?</button>
  </div>

  <!-- ===== TRACKING CARD ===== -->
  <div class="tracking-card" id="trackingCard">
    <div class="status-box">
      <span class="status-emoji">⏳</span>
      <div class="status-title">En attente de traitement</div>
      <div class="status-desc">Votre ordre est en cours de traitement. Vous serez crédité très rapidement.</div>
      <div class="progress-bar"><div class="progress-fill"></div></div>
    </div>

    <div class="ref-box">
      <div>
        <div class="ref-label">Référence de votre ordre</div>
        <div class="ref-value" id="orderRef">KP-DEP-000000</div>
      </div>
      <button class="copy-btn" onclick="copyRef()">📋 Copier</button>
    </div>

    <div class="details-table">
      <div class="details-title">Détails</div>
      <div class="detail-row">
        <span class="detail-key">Type</span>
        <span class="detail-val" id="d_type">🏦 Dépôt 1xBet</span>
      </div>
      <div class="detail-row">
        <span class="detail-key">Montant</span>
        <span class="detail-val" id="d_montant">— DJF</span>
      </div>
      <div class="detail-row">
        <span class="detail-key">Numéro Waafi</span>
        <span class="detail-val" id="d_waafi">—</span>
      </div>
      <div class="detail-row">
        <span class="detail-key">Date</span>
        <span class="detail-val" id="d_date">—</span>
      </div>
    </div>

    <div class="progression">
      <div class="prog-title">Progression</div>
      <div class="prog-step">
        <div class="prog-icon done">✅</div>
        <div>
          <div class="prog-name done">Ordre soumis</div>
          <div class="prog-desc">Demande enregistrée dans le système</div>
        </div>
      </div>
      <div class="prog-step">
        <div class="prog-icon active">⏳</div>
        <div>
          <div class="prog-name active">En cours de traitement</div>
          <div class="prog-desc">Traitement en cours</div>
        </div>
      </div>
      <div class="prog-step">
        <div class="prog-icon">○</div>
        <div>
          <div class="prog-name" style="color:var(--muted)">Envoi Waafi</div>
          <div class="prog-desc">Argent envoyé sur votre numéro</div>
        </div>
      </div>
    </div>

    <button class="support-btn" style="margin-top:16px;">💬 Contacter le support</button>
  </div>

  <footer>
    <strong>Kaffi Pay</strong><br>
    © 2025 Kaffi Pay — Tous droits réservés · Djibouti
  </footer>
</div>

<!-- TOAST -->
<div class="toast" id="toast">📋 Copié !</div>

<script>
  let currentTab = 'deposit';
  let orderCounter = 499000 + Math.floor(Math.random() * 999);

  function switchTab(tab) {
    currentTab = tab;
    document.getElementById('tabDeposit').className = 'tab-btn' + (tab === 'deposit' ? ' active' : '');
    document.getElementById('tabWithdraw').className = 'tab-btn' + (tab === 'withdraw' ? ' active' : '');
    document.getElementById('formDeposit').style.display = tab === 'deposit' ? 'block' : 'none';
    document.getElementById('formWithdraw').style.display = tab === 'withdraw' ? 'block' : 'none';
    document.getElementById('trackingCard').style.display = 'none';
    document.getElementById('secureOrBack').innerHTML = '<div class="secure-badge">🔒 Sécurisé</div>';
  }

  function showToast(msg) {
    const t = document.getElementById('toast');
    t.textContent = '📋 ' + msg;
    t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 2000);
  }

  function copyText(text, btn) {
    navigator.clipboard.writeText(text).catch(() => {});
    showToast('Copié !');
  }

  function copyRef() {
    const ref = document.getElementById('orderRef').textContent;
    navigator.clipboard.writeText(ref).catch(() => {});
    showToast('Référence copiée !');
  }

  function generateRef(type) {
    orderCounter++;
    return `KP-${type}-${orderCounter}`;
  }

  function formatDate(d) {
    const pad = n => String(n).padStart(2,'0');
    return `${pad(d.getDate())}/${pad(d.getMonth()+1)}/${d.getFullYear()} ${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`;
  }

  function showTracking(type, amount, phone, ref) {
    document.getElementById('formDeposit').style.display = 'none';
    document.getElementById('formWithdraw').style.display = 'none';
    const tc = document.getElementById('trackingCard');
    tc.style.display = 'block';

    document.getElementById('orderRef').textContent = ref;
    document.getElementById('d_type').textContent = type === 'DEP' ? '🏦 Dépôt 1xBet' : '📤 Retrait 1xBet';
    document.getElementById('d_montant').textContent = amount ? amount + ' DJF' : '—';
    document.getElementById('d_waafi').textContent = phone || '—';
    document.getElementById('d_date').textContent = formatDate(new Date());

    document.getElementById('secureOrBack').innerHTML =
      '<button class="back-btn" onclick="goBack()">← Retour</button>';

    tc.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function goBack() {
    document.getElementById('trackingCard').style.display = 'none';
    if (currentTab === 'deposit') {
      document.getElementById('formDeposit').style.display = 'block';
    } else {
      document.getElementById('formWithdraw').style.display = 'block';
    }
    document.getElementById('secureOrBack').innerHTML = '<div class="secure-badge">🔒 Sécurisé</div>';
  }

  function submitDeposit() {
    const amount = document.getElementById('d_amount').value;
    const id = document.getElementById('d_id').value;
    const hash = document.getElementById('d_hash').value;
    const phone = document.getElementById('d_phone').value;

    if (!amount || amount < 50) { showToast('Montant min. 50 DJF'); return; }
    if (!id) { showToast('ID 1xBet requis'); return; }
    if (!hash) { showToast('Hash transaction requis'); return; }

    const ref = generateRef('DEP');
    showTracking('DEP', amount, phone, ref);
  }

  function submitWithdraw() {
    const code = document.getElementById('w_code').value;
    const phone = document.getElementById('w_phone').value;
    const amount = document.getElementById('w_amount').value;

    if (!code) { showToast('Code de retrait requis'); return; }
    if (!phone) { showToast('Numéro Waafi requis'); return; }
    if (!amount || amount < 250) { showToast('Montant min. 250 DJF'); return; }

    const ref = generateRef('RET');
    showTracking('RET', amount, phone, ref);
  }
</script>
</body>
</html>
